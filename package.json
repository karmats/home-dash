{
  "name": "home-dash",
  "version": "0.1.0",
  "private": true,
  "browserslist": "> 0.25%, not dead",
  "dependencies": {
    "date-fns": "^3.6.0",
    "express": "^4.20.0",
    "express-request-id": "^3.0.0",
    "form-data": "^4.0.0",
    "googleapis": "^134.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-svg": "^16.1.34",
    "rss-parser": "^3.13.0",
    "url-loader": "^4.1.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.4",
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.24",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "@vitejs/plugin-react": "^4.2.1",
    "camelcase": "^8.0.0",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "happy-dom": "^14.5.1",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.4",
    "vite": "^5.2.8",
    "vitest": "^1.4.0"
  },
  "resolutions": {
    "node-forge": "0.10.0"
  },
  "scripts": {
    "start": "concurrently --kill-others-on-fail \"npm:client\" \"npm:server\"",
    "client": "vite",
    "preserver": "npm run build:server",
    "server": "nodemon build/server/server.js",
    "prebuild:server": "rm -rf build/server",
    "build:server": "tsc -p tsconfig.server.json",
    "prebuild:client": "rm -rf build/client",
    "build:client": "vite build",
    "postbuild:client": "cp -r public/svgs build/client",
    "build": "npm run build:client && npm run build:server",
    "test": "vitest",
    "lint": "eslint ./",
    "format": "prettier ./**/*.{html,json,md,css,ts,tsx} --write"
  }
}
